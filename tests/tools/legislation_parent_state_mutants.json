    "new": "True"
  },
  {
    "name": "https_origin",
    "old": "location.scheme == \"https\"",
    "new": "True"
  },
  {
    "name": "blob_origin",
    "old": "location.host.endswith(suffix)",
    "new": "True"
  },
  {
