[
  {
    "name": "schema",
    "old": "validator.is_valid(value)",
    "new": "True"
  },
  {
    "name": "timezone",
    "old": "result.tzinfo is not None",
    "new": "True"
  },
  {
    "name": "outer_size",
    "old": "len(raw) <= v.MAX_ZIP",
    "new": "True"
  },
  {
    "name": "member_count",
    "old": "0 < len(entries) <= v.MAX_FILES",
    "new": "True"
  },
  {
    "name": "expanded_size",
    "old": "sum(e.file_size for e in entries) <= v.MAX_EXPANDED",
    "new": "True"
  },
  {
    "name": "member_path",
    "old": "allowed_name(name), code=\"member_path\"",
    "new": "True, code=\"member_path\""
  },
  {
    "name": "duplicate_member",
    "old": "name not in files",
    "new": "True"
  },
  {
    "name": "member_size",
    "old": "entry.file_size <= v.MAX_MEMBER",
    "new": "True"
  },
  {
    "name": "member_type",
    "old": "stat.S_IFMT(entry.external_attr >> 16) in {0, stat.S_IFREG}",
    "new": "True"
  },
  {
    "name": "encrypted",
    "old": "not entry.flag_bits & 1",
    "new": "True"
  },
  {
    "name": "zip_ratio",
    "old": "entry.file_size <= max(1, entry.compress_size) * MAX_RATIO",
    "new": "True"
  },
  {
    "name": "complete_docs",
    "old": "files.keys() >= M.DOCS",
    "new": "True"
  },
  {
    "name": "state_integrity",
    "old": "v.equal(state_roots(files), reference[\"roots\"], \"parent_roots\")",
    "new": "None"
  },
  {
    "name": "artifact_expiry",
    "old": "instant(artifact[\"expires_at\"]) > now",
    "new": "True"
  },
  {
    "name": "run_completed",
    "old": "v.equal(run[\"status\"], \"completed\", \"run_status\")",
    "new": "None"
  },
  {
    "name": "run_success",
    "old": "v.equal(run[\"conclusion\"], \"success\", \"run_conclusion\")",
    "new": "None"
  },
  {
    "name": "download_size",
    "old": "len(chunks) <= limit",
    "new": "True"
  },
  {
    "name": "download_deadline",
    "old": "time.monotonic() - start <= DEADLINE",
    "new": "True"
  },
  {
