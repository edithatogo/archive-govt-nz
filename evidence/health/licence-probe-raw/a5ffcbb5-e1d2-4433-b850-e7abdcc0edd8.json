{"help": "https://catalogue.data.govt.nz/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "Ministry of Health", "author_email": "", "creator_user_id": "5ff73065-c758-4327-9f5e-8d0ebee52611", "frequency_of_update": "Annual", "id": "a5ffcbb5-e1d2-4433-b850-e7abdcc0edd8", "isopen": true, "issued": "2024-08-28", "language": "", "license_id": "CC-BY-4.0", "license_title": "Creative Commons Attribution 4.0 International", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "Evidence and Analytics", "maintainer_email": "info@health.govt.nz", "maintainer_phone": "", "metadata_created": "2025-07-15T22:30:48.358679", "metadata_modified": "2025-07-15T22:34:07.305672", "modified": "2024-08-28", "name": "health-independence-report-2023", "notes": "The Ministry of Health \u2013 Manat\u016b Hauora plays an essential role in monitoring the health system performance and supporting the Government to set the strategic direction and policy for health. The report provides robust data from 2023 and shows the progress we have made in many areas, as well as challenges we have encountered, such as disparities in health outcomes within our communities. ", "num_resources": 4, "num_tags": 0, "organization": {"id": "adde14b1-f9ea-467d-b0eb-cd78d24afbf3", "name": "ministry-of-health", "title": "Ministry of Health", "type": "organization", "description": "The Ministry of Health \u2013 Manat\u016b Hauora is the chief steward of New Zealand\u2019s health system and the lead advisor to Government on health. Our core responsibilities are policy, monitoring, and regulation, with a focus on improving health outcomes for all New Zealanders.", "image_url": "2025-06-26-000758.086326mohlogo.png", "created": "2017-02-18T21:11:53.215808", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "adde14b1-f9ea-467d-b0eb-cd78d24afbf3", "private": false, "rights": "", "source_identifier": "https://www.health.govt.nz/publica