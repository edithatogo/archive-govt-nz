{"help": "https://catalogue.data.govt.nz/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "Ministry of Health", "author_email": "", "creator_user_id": "5ff73065-c758-4327-9f5e-8d0ebee52611", "frequency_of_update": "", "id": "e89f9807-ede5-4181-99c3-81d7abf9d340", "isopen": true, "issued": "2024-06-10", "language": "", "license_id": "CC-BY-4.0", "license_title": "Creative Commons Attribution 4.0 International", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "Health Survey", "maintainer_email": "healthsurvey@health.govt.nz", "maintainer_phone": "", "metadata_created": "2025-07-01T03:10:07.881907", "metadata_modified": "2025-07-01T03:19:04.189903", "modified": "", "name": "mental-health-and-problematic-substance-use-new-zealand-health-survey", "notes": "The New Zealand Health Survey included a module on mental health and problematic substance use (including tobacco, alcohol and illicit substance use) in 2016/17, 2021/22 and 2022/23.\r\n\r\nThe Mental Health and Problematic Substance Use Data Explorer presents data from that module and covers topics such as mental health, risk of problematic substance use, informal help-seeking and access to mental health and addictions services for adults and children.\r\n\r\nIt presents the latest results by gender, age, ethnic group, disability status, and neighbourhood deprivation, as well as changes over time.", "num_resources": 1, "num_tags": 13, "organization": {"id": "adde14b1-f9ea-467d-b0eb-cd78d24afbf3", "name": "ministry-of-health", "title": "Ministry of Health", "type": "organization", "description": "The Ministry of Health \u2013 Manat\u016b Hauora is the chief steward of New Zealand\u2019s health system and the lead advisor to Government on health. Our core responsibilities are policy, monitoring, and regulation, with a focus on improving health outcomes for all New Zealanders.", "image_url": "2025-06-26-000758.086326mohlogo.png", "created": "2017-02-18T21:11:53