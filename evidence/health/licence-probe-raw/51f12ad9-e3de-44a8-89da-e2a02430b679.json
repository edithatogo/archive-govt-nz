{"help": "https://catalogue.data.govt.nz/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "Ministry of Health", "author_email": "", "creator_user_id": "df58f452-5866-4edb-b658-49e55ab53831", "frequency_of_update": "Irregular", "id": "51f12ad9-e3de-44a8-89da-e2a02430b679", "isopen": true, "issued": "2014-12-04", "language": "", "license_id": "CC-BY-4.0", "license_title": "Creative Commons Attribution 4.0 International", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "Health Survey", "maintainer_email": "healthsurvey@health.govt.nz", "maintainer_phone": "", "metadata_created": "2018-05-21T04:04:53.687179", "metadata_modified": "2025-06-26T03:17:53.696938", "modified": "", "name": "tobacco-use-2012-13-new-zealand-health-survey", "notes": "The tobacco use report presents key findings from the New Zealand Health Survey 2012/13 about tobacco use. It provides a snapshot of tobacco use by adults over the age of 15 years, across different population groups (age, sex, ethnicity and neighbourhood deprivation). It presents information on when smokers smoked their first cigarette and how this has changed over time. Detailed data is also provided on who is quitting smoking and how they are quitting. Second-hand smoke exposure for adults and children is also presented in this report.", "num_resources": 11, "num_tags": 14, "organization": {"id": "adde14b1-f9ea-467d-b0eb-cd78d24afbf3", "name": "ministry-of-health", "title": "Ministry of Health", "type": "organization", "description": "The Ministry of Health \u2013 Manat\u016b Hauora is the chief steward of New Zealand\u2019s health system and the lead advisor to Government on health. Our core responsibilities are policy, monitoring, and regulation, with a focus on improving health outcomes for all New Zealanders.", "image_url": "2025-06-26-000758.086326mohlogo.png", "created": "2017-02-18T21:11:53.215808", "is_organization": true, "approval_status": "approved", "state": "