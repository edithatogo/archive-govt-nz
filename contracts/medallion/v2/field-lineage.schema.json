{
  "$id": "https://edithatogo.github.io/contracts/medallion/v2/field-lineage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-repository field-level lineage vocabulary v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabulary_version", "records"],
  "properties": {
    "vocabulary_version": {"const": "2.0.0"},
    "records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldLineage"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeDataset": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fieldLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id", "source_dataset", "source_field", "transformation_id",
        "output_dataset", "output_field", "code_version", "input_sha256",
        "output_sha256", "rights_decision_id"
      ],
      "properties": {
        "record_id": {"$ref": "#/$defs/sha256"},
        "source_dataset": {"$ref": "#/$defs/safeDataset"},
        "source_field": {"type": "string", "minLength": 1},
        "transformation_id": {"type": "string", "minLength": 1},
        "output_dataset": {"$ref": "#/$defs/safeDataset"},
        "output_field": {"type": "string", "minLength": 1},
        "code_version": {"type": "string", "pattern": "^(?:git:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "rights_decision_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
