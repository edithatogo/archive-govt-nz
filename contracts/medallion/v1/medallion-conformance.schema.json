{
  "$id": "https://edithatogo.github.io/contracts/medallion/v1/medallion-conformance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-repository medallion conformance vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["vocabulary_version", "repository", "artifacts", "promotion_decisions"],
  "properties": {
    "vocabulary_version": {"const": "1.0.0"},
    "repository": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "promotion_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/promotion"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "layer": {"enum": ["bronze_b0", "bronze_b1", "bronze_b2", "silver", "gold", "platinum"]},
    "rightsDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "status", "scope", "reason_codes"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["approved", "restricted", "pending", "blocked"]},
        "scope": {"type": "string", "minLength": 1},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_artifact_ids", "input_sha256"],
      "properties": {
        "input_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "input_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "layer", "sha256", "lineage", "rights_decision", "promotion_status"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "layer": {"$ref": "#/$defs/layer"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "lineage": {"$ref": "#/$defs/lineage"},
        "rights_decision": {"$ref": "#/$defs/rightsDecision"},
        "promotion_status": {"enum": ["candidate", "approved_within_scope", "blocked", "rejected"]}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "subject_artifact_id", "from_layer", "to_layer", "input_sha256", "required_gate_ids", "passed_gate_ids", "rights_decision", "status", "fail_closed", "reason_codes"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "subject_artifact_id": {"type": "string", "minLength": 1},
        "from_layer": {"$ref": "#/$defs/layer"},
        "to_layer": {"$ref": "#/$defs/layer"},
        "input_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "required_gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "passed_gate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rights_decision": {"$ref": "#/$defs/rightsDecision"},
        "status": {"enum": ["approved", "blocked", "rejected"]},
        "fail_closed": {"const": true},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
          "then": {"properties": {"rights_decision": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}}}
        }
      ]
    }
  }
}
