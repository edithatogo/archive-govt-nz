{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive.govt.nz/schemas/election/silver-longitudinal-elections-v1.schema.json",
  "title": "SilverLongitudinalElectionsV1",
  "description": "Normalized historical longitudinal election records across all New Zealand MMP cycles (1996–2026).",
  "type": "object",
  "required": [
    "election_year",
    "total_registered_electors",
    "total_votes_cast",
    "turnout_percentage",
    "nominal_seats",
    "overhang_seats",
    "total_house_seats",
    "majority_threshold",
    "total_campaign_spend_nominal",
    "total_campaign_spend_cpi_adjusted_2026",
    "mean_cost_per_vote_cpi_adjusted",
    "mean_cost_per_mp_cpi_adjusted",
    "party_summaries"
  ],
  "properties": {
    "election_year": { "type": "integer", "minimum": 1996, "maximum": 2035 },
    "total_registered_electors": { "type": "integer", "minimum": 1000000 },
    "total_votes_cast": { "type": "integer", "minimum": 1000000 },
    "turnout_percentage": { "type": "number", "minimum": 50.0, "maximum": 100.0 },
    "nominal_seats": { "type": "integer", "default": 120 },
    "overhang_seats": { "type": "integer", "minimum": 0 },
    "total_house_seats": { "type": "integer", "minimum": 120 },
    "majority_threshold": { "type": "integer", "minimum": 61 },
    "total_campaign_spend_nominal": { "type": "number", "minimum": 0 },
    "total_campaign_spend_cpi_adjusted_2026": { "type": "number", "minimum": 0 },
    "mean_cost_per_vote_cpi_adjusted": { "type": "number", "minimum": 0 },
    "mean_cost_per_mp_cpi_adjusted": { "type": "number", "minimum": 0 },
    "party_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "party_name",
          "party_vote_share",
          "electorate_seats",
          "list_seats",
          "total_seats",
          "cost_per_vote_real",
          "cost_per_elected_mp_real"
        ],
        "properties": {
          "party_name": { "type": "string" },
          "party_vote_share": { "type": "number", "minimum": 0, "maximum": 100 },
          "electorate_seats": { "type": "integer", "minimum": 0 },
          "list_seats": { "type": "integer", "minimum": 0 },
          "total_seats": { "type": "integer", "minimum": 0 },
          "overhang_seats": { "type": "integer", "minimum": 0, "default": 0 },
          "cost_per_vote_real": { "type": "number", "minimum": 0 },
          "cost_per_elected_mp_real": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
