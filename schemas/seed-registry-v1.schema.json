              "discovery_run_id": 27313765016,
              "discovery_artifact": "historical-work-id-discovery",
              "relationship": "first 500 ASCII-sorted unique candidate IDs; batch 1 of 68",
              "full_coverage_proven": false
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
