{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PublicationManifestV2",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "bundle_name",
    "version",
    "created_at",
    "bundle_root_sha256",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "archive-govt-nz.publication-manifest/v2"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "bundle_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["platform", "target_identifier", "enabled"],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["huggingface", "zenodo", "osf", "github_releases"]
          },
          "target_identifier": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_path",
          "sha256",
          "blake3",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "item_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "blake3": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "ro_crate": {
      "type": ["object", "null"]
    },
    "croissant": {
      "type": ["object", "null"]
    }
  },
  "additionalProperties": false
}
