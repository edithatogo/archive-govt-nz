{
  "$id": "https://archive-govt-nz.org/schemas/legislation-publication-observation-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "properties": {
    "files": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 268435456,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "sha256",
          "size_bytes"
        ],
        "type": "object"
      },
      "maxProperties": 4096,
      "propertyNames": {
        "pattern": "^durable-state/v1/[0-9a-f]{64}/(?:metadata\\.json|state\\.zip)$"
      },
      "type": "object"
    },
    "repository": {
      "const": "edithatogo/corpus-legislation-nz"
    },
    "revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "repository",
    "revision",
    "files"
  ],
  "type": "object"
}
