{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceManifestV1",
  "type": "object",
  "required": [
    "schema_version",
    "source_id",
    "source_uri",
    "source_type",
    "agency_slug",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "source_id": { "type": "string" },
    "source_uri": {
      "type": "string",
      "pattern": "^(ckan|bluesky|threads|x|youtube|feed|email|web)://.+"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "ckan",
        "bluesky",
        "threads",
        "x",
        "youtube",
        "feed",
        "email",
        "web"
      ]
    },
    "agency_slug": { "type": "string" },
    "title": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "quarantined", "tombstoned"]
    },
    "withdrawal_reason": { "type": ["string", "null"] },
    "metadata": { "type": "object" }
  }
}
