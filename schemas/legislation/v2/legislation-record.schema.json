{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.archive.govt.nz/legislation/v2/legislation-record.schema.json",
  "title": "LegislationRecordV2",
  "description": "Schema for canonical normalised New Zealand legislation records (v2 extended).",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "work_id",
    "title",
    "legislation_type",
    "status",
    "canonical_uri",
    "raw_cas_hash_sha256",
    "raw_cas_hash_blake3",
    "retrieval_timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "archive-govt-nz.legislation/v2"
    },
    "document_id": {
      "type": "string"
    },
    "work_id": {
      "type": "string"
    },
    "expression_id": {
      "type": ["string", "null"]
    },
    "manifestation_id": {
      "type": ["string", "null"]
    },
    "title": {
      "type": "string"
    },
    "legislation_type": {
      "type": "string",
      "enum": ["act", "bill", "regulation", "deemed_regulation", "order_in_council", "other"]
    },
    "status": {
      "type": "string",
      "enum": ["in_force", "amended", "repealed", "bill_introduced", "bill_passed", "historical", "unknown"]
    },
    "status_uncertain": {
      "type": "boolean"
    },
    "canonical_uri": {
      "type": "string",
      "format": "uri"
    },
    "raw_cas_hash_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_cas_hash_blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "retrieval_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source_modified_timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "assent_date": {
      "type": ["string", "null"]
    },
    "commencement_date": {
      "type": ["string", "null"]
    },
    "sections_count": {
      "type": "integer",
      "minimum": 0
    },
    "schedules_count": {
      "type": "integer",
      "minimum": 0
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relationship_type", "target_work_id"],
        "properties": {
          "relationship_type": {
            "type": "string",
            "enum": ["amends", "amended_by", "repeals", "repealed_by", "replaces", "replaced_by"]
          },
          "target_work_id": {
            "type": "string"
          },
          "effective_date": {
            "type": ["string", "null"]
          },
          "note": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_system", "record_id", "ingested_at", "agent"],
        "properties": {
          "source_system": {
            "type": "string"
          },
          "record_id": {
            "type": "string"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time"
          },
          "agent": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "rights_statement": {
      "type": ["string", "null"]
    },
    "redistribution_policy": {
      "type": ["string", "null"]
    },
    "plain_text": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
