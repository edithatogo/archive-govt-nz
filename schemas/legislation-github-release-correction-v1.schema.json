    "correction_id",
    "issued_at",
    "repository",
    "target_baseline_commit",
    "release",
    "hosted_evidence",
    "correction",
    "authority",
    "addendum",
    "external_action",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "archive-govt-nz.legislation-github-release-correction/v1"
    },
    "correction_id": {
      "const": "legislation-cutover-v1.0.0-cycle-1-recovery-run"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "edithatogo/archive-govt-nz"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "name",
        "url",
        "published_at",
        "draft",
        "prerelease",
        "is_immutable",
        "tag_commit",
        "snapshot_path",
        "normalized_snapshot_sha256",
        "body_sha256",
        "original_body",
