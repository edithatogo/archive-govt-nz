{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/archive-govt-nz/schemas/legislation-github-release-correction-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
