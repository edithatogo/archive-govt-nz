{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive-govt-nz.example/schemas/health-metadata-rights-assertions-v1.schema.json",
  "title": "Health metadata resource-level rights assertions",
  "description": "Shape and internal consistency only; this schema does not establish rights eligibility or publication approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resources"],
  "properties": {
    "schema_version": {"const": "archive-govt-nz.health-metadata-rights-assertions/v1"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/resource"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "payload_sha256", "state", "license", "evidence_sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}(?:/[A-Za-z0-9][A-Za-z0-9_.-]{0,79})*$"
        },
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "state": {"enum": ["unresolved", "restricted", "eligible_asserted"]},
        "license": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "evidence_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "eligible_asserted"}}},
          "then": {
            "properties": {
              "license": {"type": "string", "minLength": 1, "pattern": "^.*\\S.*$"},
              "evidence_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "license": {"type": "null"},
              "evidence_sha256": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
