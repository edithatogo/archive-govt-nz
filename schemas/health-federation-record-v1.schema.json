{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive-govt-nz.example/schemas/health-federation-record-v1.schema.json",
  "title": "Offline Health federation evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "observation_mode", "disposition", "source", "target", "mapping", "period", "lineage"],
  "properties": {
    "schema_version": {"const": "archive-govt-nz.health-federation-record/v1"},
    "record_id": {"type": "string", "pattern": "^fixture:[a-z0-9][a-z0-9._/-]{0,127}$"},
    "observation_mode": {"const": "offline_fixture"},
    "disposition": {"enum": ["unmatched", "ambiguous"]},
    "source": {"$ref": "#/$defs/entity"},
    "target": {"$ref": "#/$defs/entity"},
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence"],
      "properties": {
        "method": {"const": "none"},
        "confidence": {"type": "null"}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "basis"],
      "properties": {
        "start": {"type": "string", "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"},
        "end": {"type": "string", "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"},
        "basis": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest_sha256", "source_record_ids", "target_manifest_sha256", "target_record_ids"],
      "properties": {
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "source_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "target_manifest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "target_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "scheme_version", "key"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]{1,200}$"},
        "scheme_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "key": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "unmatched"}}},
      "then": {
        "properties": {
          "target": {"properties": {"key": {"const": null}}},
          "lineage": {"properties": {"target_manifest_sha256": {"const": null}, "target_record_ids": {"maxItems": 0}}}
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "ambiguous"}}},
      "then": {
        "properties": {
          "target": {"properties": {"key": {"const": null}}},
          "lineage": {"properties": {"target_manifest_sha256": {"$ref": "#/$defs/sha256"}, "target_record_ids": {"minItems": 2}}}
        }
      }
    }
  ]
}
