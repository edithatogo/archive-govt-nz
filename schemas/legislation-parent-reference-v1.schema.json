{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive-govt-nz.org/schemas/legislation-parent-reference-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "repository_id",
    "workflow",
    "run",
    "artifact",
    "roots",
    "state_schemas",
    "source",
    "lineage_sha256"
  ],
  "if": {
    "properties": {
      "workflow": {
        "properties": {
          "path": {
            "const": ".github/workflows/exact-inventory.yml"
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "artifact": {
        "properties": {
          "name": {
            "pattern": "^legislation-exact-inventory-state-[1-9][0-9]*-[1-9][0-9]*$"
          }
        }
      }
    }
  },
  "else": {
    "properties": {
      "artifact": {
        "properties": {
          "name": {
            "pattern": "^legislation-state-[1-9][0-9]*$"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "archive-govt-nz.legislation-parent-reference/v1"
    },
    "repository": {
      "const": "edithatogo/archive-govt-nz"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[a-z0-9][a-z0-9_-]*\\.ya?ml$"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "head_sha",
        "head_branch",
        "run_attempt"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_branch": {
          "const": "main"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "digest",
        "size_in_bytes",
        "expired",
        "expires_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_in_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "expired": {
          "const": false
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256",
        "manifest_file_sha256",
        "checkpoint_file_sha256",
        "inventory_sha256",
        "cas_root_sha256",
        "success_receipt_sha256"
      ],
      "properties": {
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "checkpoint_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cas_root_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "success_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "state_schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "checkpoint",
        "success_receipt"
      ],
      "properties": {
        "manifest": {
          "const": "archive-govt-nz.legislation-manifest/v1"
        },
        "checkpoint": {
          "const": "archive-govt-nz.legislation-checkpoint/v1"
        },
        "success_receipt": {
          "enum": [
            "archive-govt-nz.legislation-harvest-receipt/v2",
            "archive-govt-nz.legislation-harvest-receipt/v3"
          ]
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_set",
            "seed_id",
            "seed_sha256"
          ],
          "properties": {
            "source_set": {
              "const": "legislation"
            },
            "seed_id": {
              "const": null
            },
            "seed_sha256": {
              "const": null
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_set",
            "seed_id",
            "seed_sha256"
          ],
          "properties": {
            "source_set": {
              "const": "legislation"
            },
            "seed_id": {
              "const": "historical-work-ids-0001"
            },
            "seed_sha256": {
              "const": "59923176fa34796d7673a20b880af9abe5520fe484595edb220f2bbc0e3b33e7"
            }
          }
        }
      ]
    },
    "lineage_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
