{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive.govt.nz/schemas/riopa/v1/riopa-source-capture.schema.json",
  "title": "RIOPA source and capture evidence",
  "type": "object",
  "required": ["schema_version", "source", "capture", "boundaries", "status"],
  "properties": {
    "schema_version": {"const": "archive-govt-nz.riopa-source-capture/v1"},
    "source": {
      "type": "object", "required": ["source_id", "archive_id", "source_url", "revision"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "archive_id": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "capture": {
      "type": "object", "required": ["capture_id", "receipt_id", "object_id", "sha256", "observed_at", "status"],
      "properties": {
        "capture_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "receipt_id": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "boundaries": {
      "type": "object", "required": ["rights", "capability", "source_health", "legal_status"],
      "properties": {
        "rights": {"type": "object"}, "capability": {"type": "object"},
        "source_health": {"type": "object"}, "legal_status": {"type": "object"}
      }, "additionalProperties": false
    },
    "status": {"enum": ["eligible", "quarantined"]},
    "quarantine_reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
