{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive-govt-nz.example/schemas/health-federation-tables-v1.schema.json",
  "title": "Local evidence-scoped federation table inventory with zero approved joins",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "mapping_review_sha256",
    "readiness_sha256",
    "retained_checksum_mismatches",
    "approved_links",
    "excluded_pairs",
    "source_records",
    "partner_records",
    "tables",
    "positive_link_admission",
    "other_relationships",
    "rights_policy",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "archive-govt-nz.health-federation-tables/v1"
    },
    "scope": {
      "const": "qualified_annual_vote_total_only"
    },
    "mapping_review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "readiness_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retained_checksum_mismatches": {
      "type": "integer",
      "minimum": 0
    },
    "approved_links": {
      "const": 0
    },
    "excluded_pairs": {
      "type": "integer",
      "minimum": 2,
      "maximum": 10
    },
    "source_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "partner_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_records.parquet",
        "partner_records.parquet",
        "mapping_dispositions.parquet",
        "approved_links.parquet"
      ],
      "properties": {
        "source_records.parquet": {
          "$ref": "#/$defs/table"
        },
        "partner_records.parquet": {
          "$ref": "#/$defs/table"
        },
        "mapping_dispositions.parquet": {
          "$ref": "#/$defs/table"
        },
        "approved_links.parquet": {
          "allOf": [
            {
              "$ref": "#/$defs/table"
            },
            {
              "properties": {
                "rows": {
                  "const": 0
                }
              }
            }
          ]
        }
      }
    },
    "positive_link_admission": {
      "const": "not_qualified"
    },
    "other_relationships": {
      "const": "not_assessed"
    },
    "rights_policy": {
      "const": "source_specific_not_inherited"
    },
    "publication": {
      "const": "not_performed"
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "sha256",
        "bytes",
        "arrow_schema_sha256",
        "fields"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "arrow_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "nullable"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              },
              "nullable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
